#!/bin/sh
# SDD pre-commit hook. Enable with: git config core.hooksPath .githooks
# Runs spec and build-system validation before each commit.

if command -v pwsh >/dev/null 2>&1; then
    shell="pwsh"
elif command -v powershell >/dev/null 2>&1; then
    shell="powershell"
else
    echo "pre-commit: PowerShell (pwsh or powershell) is required to run SDD validation." >&2
    exit 1
fi

"$shell" -ExecutionPolicy Bypass -File ./tools/sdd/validate-specs.ps1 || exit 1
"$shell" -ExecutionPolicy Bypass -File ./tools/sdd/verify-build-spec.ps1 || exit 1
